# Bu dosyayi ".env" adiyla kopyala ve kendi anahtarlarini yaz.
# .env dosyasi .gitignore ile GitHub'a yuklenmez; bu ornek dosyada gercek anahtar OLMAMALI.
#
# Copernicus Data Space -> Sentinel Hub panel -> User settings -> OAuth clients
SH_CLIENT_ID=buraya-kendi-client-id
SH_CLIENT_SECRET=buraya-kendi-client-secret
#
# NASA FIRMS -> https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=buraya-kendi-firms-anahtari
#
# Open-Meteo icin anahtar gerekmez.
# Dashboard (dashboard/app.py) hicbir anahtar kullanmaz.
